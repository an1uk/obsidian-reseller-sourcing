{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"], "strict": true,
    "skipLibCheck": true, "isolatedModules": true, "noEmit": true,
    "esModuleInterop": true, "types": ["node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
